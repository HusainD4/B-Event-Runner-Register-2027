# SERVER CONFIGURATION
PORT=3000
NODE_ENV=development
# On production, default to 127.0.0.1. Set loopback only behind a trusted local reverse proxy.
HOST=
TRUST_PROXY=false

# PDF e-ticket renderer: use the public frontend origin, or leave empty for local frontend/dist.
PDF_FRONTEND_URL=
PDF_FRONTEND_DIST=
PDF_CHROME_PATH=

# DATABASE CONFIGURATION
DATABASE_URL="mysql://root:@localhost:3306/tegal_run_db"

# REDIS CONFIGURATION (CACHE & QUEUE)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT CONFIGURATION
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial administrator bootstrap (only used when no admin account exists)
# Use a randomly generated value with at least 16 characters.
INITIAL_SUPERADMIN_PASSWORD=

# Development-only seed credentials (the destructive seed is disabled in production)
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_FINANCE_PASSWORD=

# MIDTRANS PAYMENT GATEWAY
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false
