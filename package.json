{
  "name": "tegal-run-backend-2027",
  "version": "1.0.0",
  "description": "Backend API untuk Tegal Run 2027 - War Tiket & Registration System",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/prepare-dist.mjs",
    "start": "node dist/server.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-superadmin": "tsx prisma/bootstrap-superadmin.ts",
    "db:reset-admin": "tsx prisma/reset-and-seed-admin.ts",
    "test": "npm --prefix ../frontend run build && npm run build && node --import tsx --test tests/backup.test.mjs tests/clear-participants.test.mjs tests/production-readiness.test.mjs tests/webhook-hardening.test.mjs tests/whatsapp-session.test.mjs tests/notification-templates.test.mjs tests/pdf-delivery.test.mjs tests/manual-pdf-dispatch.test.mjs tests/manual-pdf-ui.test.mjs tests/whatsapp-history.test.mjs"
  },
  "keywords": [
    "tegal-run",
    "marathon",
    "ticket-war",
    "express",
    "prisma"
  ],
  "author": "Husain Mulyansyah",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.4.3",
    "nodemailer": "^10.4.0",
    "playwright-core": "^1.56.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.1",
    "@types/socket.io": "^3.0.2",
    "pdfjs-dist": "^5.4.296",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
